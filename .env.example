# =====================================================
# CRM Environment Variables - Example Configuration
# =====================================================
# Copy this file to .env and update with your values
# DO NOT commit .env to git (it's in .gitignore)
# =====================================================

# ========== Server Configuration ==========
NODE_ENV=production
PORT=4000

# ========== Database Configuration ==========
# Option 1: Individual settings
DATABASE_HOST=your-db-host.railway.app
DATABASE_PORT=5432
DATABASE_NAME=samcrm
DATABASE_USER=postgres
DATABASE_PASSWORD=your-secure-password
DATABASE_SSL=true

# Option 2: Connection string (takes precedence if set)
# DATABASE_URL=postgresql://postgres:password@host:5432/dbname

# ========== Tally Configuration ==========
# Leave empty if not using Tally in cloud
TALLY_URL=

# ========== Backend Mode ==========
# Options: LOCAL, LIVE, OFFLINE, DUMMY_DATA
BACKEND_MODE=LIVE

# Live server URL (your cloud deployment URL)
LIVE_SERVER_URL=https://your-app.railway.app

# ========== CORS Configuration ==========
# Comma-separated list of allowed origins
CORS_ORIGIN=https://your-frontend.vercel.app,https://your-app.railway.app

# Frontend URL (if deployed separately)
FRONTEND_URL=https://your-frontend.vercel.app

# ========== User Limits ==========
MAX_ADMINS=5
MAX_TOTAL_USERS=200

# ========== Service Control ==========
SERVICE_ENABLED=true
