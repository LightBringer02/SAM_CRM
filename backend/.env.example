# =====================================================
# CRM Application Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =====================================================

# ========== Server Configuration ==========
NODE_ENV=production
PORT=4000

# ========== Database Configuration ==========
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=samcrm
DATABASE_USER=admin
DATABASE_PASSWORD=your_secure_password_here
DATABASE_SSL=false

# ========== Security Configuration ==========
# Secret key for API authentication (generate a random 64-char string)
API_SECRET_KEY=your_api_secret_key_here

# JWT secret for token signing (generate a random 64-char string)
JWT_SECRET=your_jwt_secret_here

# Session secret (generate a random 64-char string)
SESSION_SECRET=your_session_secret_here

# ========== CORS Configuration ==========
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ========== Tally Configuration ==========
TALLY_URL=http://localhost:9000

# ========== Rate Limiting ==========
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========== Logging ==========
LOG_LEVEL=info

# ========== Cloud/Production Settings ==========
# Enable for cloud databases that require SSL
# DATABASE_SSL=true

# =====================================================
# SECURITY NOTES:
# 1. Never expose this file in version control
# 2. Use strong, unique passwords for all services
# 3. Rotate secrets regularly
# 4. Use environment-specific values for each deployment
# =====================================================
